---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import TableSort from '../components/TableSort.astro';
import { season, longDate, num, playerHref } from '../lib/season.js';
import { u } from '../lib/url.js';

const { roster } = season;

const heights = roster.map((p) => p.height);
const minHeight = Math.min(...heights);
const maxHeight = Math.max(...heights);
const born = roster.map((p) => Number(p.birthdate.slice(0, 4)));

/** Age on the day of the final, 9 June 2012. */
const age = (iso) => {
  const [y, m, d] = iso.split('-').map(Number);
  let a = 2012 - y;
  if (m > 6 || (m === 6 && d > 9)) a -= 1;
  return a;
};

// The roster reads alphabetically the way a distinta does; every column can
// reorder it from there.
const squad = [...roster].sort((a, b) => a.surname.localeCompare(b.surname, 'it'));

const avgHeight = heights.reduce((s, h) => s + h, 0) / heights.length;
const avgAge = roster.reduce((s, p) => s + age(p.birthdate), 0) / roster.length;

const byHeight = [...roster].sort((a, b) => a.height - b.height);
const shortest = byHeight[0];
const tallest = byHeight[byHeight.length - 1];

const byAge = [...roster].sort((a, b) => age(a.birthdate) - age(b.birthdate));
const youngest = byAge[0];
const oldest = byAge[byAge.length - 1];

// The bar under each height measures the roster's own spread. It starts ten
// centimetres below the shortest player so his bar is a mark, not an absence.
const floor = minHeight - 10;
const bar = (h) => ((h - floor) / (maxHeight - floor)) * 100;
---

<Base
  title="La squadra · Caffè Matic – Trottola Sport 2011-2012"
  description="I diciannove giocatori che hanno vinto la Super-League Promozione CSI 2011-2012."
  current="squadra"
>
  <PageHead
    title="La squadra"
    facts={[
      `${roster.length} giocatori`,
      `${minHeight}–${maxHeight} cm`,
      `nati ${Math.min(...born)}–${Math.max(...born)}`,
    ]}
  >
    <p>
      Diciannove giocatori schierati a referto in stagione: il più giovane,{' '}
      <strong>{youngest.surname} {youngest.name}</strong>, aveva{' '}
      {age(youngest.birthdate)} anni; il più vecchio,{' '}
      <strong>{oldest.surname} {oldest.name}</strong>, ne aveva{' '}
      {age(oldest.birthdate)}.
    </p>
  </PageHead>

  <section class="section">
    <div class="wrap">
      <ul class="glance">
        <li>
          <span class="g-v">{num(avgHeight, 1)}<span class="g-u">cm</span></span>
          <span class="g-k mono">altezza media</span>
          <span class="g-sub mono dim">
            dai {shortest.height} di {shortest.surname} ai {tallest.height} di {tallest.surname}
          </span>
        </li>
        <li>
          <span class="g-v">{num(avgAge, 1)}<span class="g-u">anni</span></span>
          <span class="g-k mono">età media</span>
          <span class="g-sub mono dim">
            al 9 giugno 2012, il giorno della finale
          </span>
        </li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="section-title">La rosa</h2>
        <p class="section-note">
          In ordine alfabetico, come su una distinta.{' '}
          <strong>Clicca un'intestazione</strong> per riordinare per ruolo,
          altezza o data di nascita, <strong>clicca un nome</strong> per la
          stagione di quel giocatore.
        </p>
      </div>

      <div class="table-scroll">
        <table class="roster" data-sortable>
          <caption class="visually-hidden">
            I diciannove giocatori della rosa 2011-2012
          </caption>
          <thead>
            <tr>
              <th scope="col" class="num rank">#</th>
              <th scope="col" class="c-name" data-sort="text" aria-sort="ascending">Giocatore</th>
              <th scope="col" class="c-role" data-sort="text">Ruolo</th>
              <th scope="col" class="num c-height" data-sort="num">Altezza</th>
              <th scope="col" class="c-born" data-sort="text" data-dir="asc">Nato il</th>
            </tr>
          </thead>
          <tbody>
            {squad.map((p, i) => (
              <tr>
                <td class="num rank faint"><span data-rank>{i + 1}</span></td>
                <td class="name c-name" data-v={`${p.surname} ${p.name}`}>
                  <a class="p-link" href={playerHref(p.id)}>
                    <span class="p-surname">{p.surname}</span>{' '}
                    <span class="p-name">{p.name}</span>
                  </a>
                </td>
                <td class="c-role"><span class="role mono">{p.role}</span></td>
                <td class="num c-height" data-v={p.height}>
                  <span class="h-v">{p.height}<span class="h-u">cm</span></span>
                  <span class="h-track" aria-hidden="true">
                    <span class="h-bar" style={`--w:${bar(p.height)}%`}></span>
                  </span>
                </td>
                <td class="mono born c-born" data-v={p.birthdate}>
                  {longDate(p.birthdate)}
                  <span class="b-age dim">{age(p.birthdate)} anni</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="section-note dim">
        L'età è quella del giorno della finale. Punti, presenze e tabellini di
        ogni giocatore sono nelle{' '}
        <a class="link" href={u('/statistiche/')}>statistiche</a>.
      </p>
    </div>
  </section>

  <TableSort />
</Base>

<style>
  /* --- roster table ------------------------------------------------------- */
  /* Fixed layout keeps the proportions below; the min-width stops it from
     squeezing them into each other, and hands narrow screens a scroll. */
  .roster { font-size: var(--step-0); table-layout: fixed; min-width: 44rem; }
  .roster td { padding-block: 0.7rem; vertical-align: middle; }
  .roster tbody tr { transition: background 0.15s ease; }

  /* Fixed proportions: the name gets the room, the rest only what it needs,
     so nineteen short rows don't drift apart across a 1180px page. */
  .rank { width: 3rem; }
  .c-name { width: 32%; }
  .c-role { width: 22%; }
  .c-height { width: 11rem; }

  .p-surname {
    font-family: var(--font-display);
    font-size: var(--step-1);
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .p-name { color: var(--chalk-dim); }

  .role {
    display: inline-block;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--chalk-dim);
    border: 1px solid var(--ink-line);
    padding: 0.2rem 0.5rem;
    white-space: nowrap;
  }
  tbody tr:hover .role { border-color: var(--giallo-deep); color: var(--chalk); }

  .h-v {
    font-family: var(--font-mono);
    font-size: var(--step-0);
    color: var(--chalk);
  }
  .h-u {
    font-size: 0.62em;
    color: var(--chalk-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-left: 0.2rem;
  }

  /* The track under the figure measures the roster's own spread, so the
     column reads as a ladder rather than as nineteen loose numbers. */
  .h-track {
    display: block;
    width: 100%;
    height: 2px;
    margin: 0.4rem 0 0 auto;
    background: var(--ink-line);
  }
  .h-bar { display: block; height: 100%; width: var(--w); background: var(--giallo-deep); }
  tbody tr:hover .h-bar { background: var(--giallo); }

  .born { color: var(--chalk-dim); white-space: nowrap; }
  .b-age {
    font-size: 0.68em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--chalk-faint);
    margin-left: 0.7rem;
  }

  /* Once the table starts scrolling sideways the name stays put: a row of
     measurements is worth nothing without the player it belongs to. */
  @media (max-width: 820px) {
    .rank { display: none; }
    .roster .c-name {
      position: sticky;
      left: 0;
      z-index: 1;
      background: var(--ink);
      box-shadow: 1px 0 0 var(--ink-line);
    }
    .roster thead th.c-name { z-index: 3; }
    .roster tbody tr:hover td.c-name { background: var(--ink-raised); }
  }
</style>
