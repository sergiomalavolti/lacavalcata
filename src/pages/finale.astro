---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Seed from '../components/Seed.astro';
import Referto from '../components/Referto.astro';
import {
  season, teamName, teamShort, US, longDate, playerName, groupGames,
} from '../lib/season.js';

import scoreboard from '../assets/3.jpg';
import huddle from '../assets/1.jpg';
import warmup from '../assets/2.jpg';
import teamPhoto from '../assets/final_game.jpg';
import teamPhotoWide from '../assets/final_game-2.jpg';

const files = {
  '3.jpg': scoreboard,
  '1.jpg': huddle,
  '2.jpg': warmup,
  'final_game.jpg': teamPhoto,
  'final_game-2.jpg': teamPhotoWide,
};

const { final } = season;
const game = final.game;
const opponent = game.opponent;
const seeds = season.playoff.seeds;
const seedOf = (t) => seeds.find((s) => s.team === t)?.seed;

const q = game.quarters;
// Running score at the end of each quarter.
const running = q.us.map((_, i) => [
  q.us.slice(0, i + 1).reduce((a, b) => a + b, 0),
  q.them.slice(0, i + 1).reduce((a, b) => a + b, 0),
]);

const vsAmadeus = groupGames.filter((g) => g.opponent === opponent);
const topScorers = [...game.boxscore]
  .filter((l) => l.played)
  .sort((a, b) => b.points - a.points)
  .slice(0, 3);

const photo = (fileName) => final.photos.find((p) => p.file === fileName);
const heroPhoto = photo('3.jpg');
const gallery = final.photos.filter((p) => p.file !== '3.jpg');

// The decisive (last-played) game of each series: gara 3 in both cases.
const decider = (phase) => {
  const legs = season.games.filter((g) => g.phase === phase);
  return legs[legs.length - 1];
};
const quartiDecider = decider('quarti');
const semiDecider = decider('semifinale');
const sergioNumber = game.boxscore.find((l) => l.player === 'malavolti-sergio')?.number;

// The opponent's own road to Loiano, read off the bracket.
const theirRun = season.playoff.bracket
  .filter((r) => r.id !== 'finale')
  .map((r) => {
    const s = r.series.find((x) => x.teamA === opponent || x.teamB === opponent);
    if (!s) return null;
    const other = s.teamA === opponent ? s.teamB : s.teamA;
    const wins = s.teamA === opponent ? s.winsA : s.winsB;
    const losses = s.teamA === opponent ? s.winsB : s.winsA;
    return { label: r.label, other, wins, losses };
  })
  .filter(Boolean);
---

<Base
  title="La finale · 9 giugno 2012, Palasport di Loiano"
  description="Caffè Matic – Trottola Sport batte Birreria Amadeus 66-55 e vince la Super-League Promozione CSI 2011-2012."
  current="finale"
>
  <section class="hero">
    <Image
      src={scoreboard}
      alt={heroPhoto.alt}
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero-img"
    />
    <div class="hero-shade"></div>

    <div class="hero-body wrap">
      <p class="eyebrow">
        <span>Finale Super-League</span>
        <span>{longDate(game.date)}</span>
        <span>{final.venueName}</span>
      </p>

      <h1>
        <span class="line">La finale</span>
      </h1>

      <p class="hero-score mono">
        <span class="them">{game.theirScore}</span>
        <span class="dash">–</span>
        <span class="ours">{game.ourScore}</span>
      </p>

      <p class="hero-teams">
        <span>
          <Seed n={seedOf(opponent)} /> {teamName(opponent)}
        </span>
        <span class="us">
          <Seed n={seedOf(US)} us /> {teamName(US)}
        </span>
      </p>

      <p class="hero-credit mono">{heroPhoto.caption}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="facts">
        <div>
          <p class="fact-k mono">Quando</p>
          <p class="fact-v">{final.when}</p>
        </div>
        <div>
          <p class="fact-k mono">Dove</p>
          <p class="fact-v">{final.venueName}</p>
          <p class="fact-sub mono dim">{final.address}</p>
        </div>
        <div>
          <p class="fact-k mono">Maglie</p>
          <p class="fact-v">
            <span class="kit kit-us">gialla</span>
            <span class="kit kit-them">nera</span>
          </p>
        </div>
        <div>
          <p class="fact-k mono">Alla vincente</p>
          <p class="fact-v">Borsa medica</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose-block">
      <h2>Terza volta</h2>
      <p>
        Nel girone il Birreria Amadeus aveva vinto tutte e due le partite: 60–58
        a Porretta alla prima giornata, 54–42 a Bologna al ritorno. Aveva chiuso
        primo con 37 punti, quattro più del Caffè Matic, ed era arrivato alla
        finale da testa di serie numero {seedOf(opponent)} senza perdere una
        serie.
      </p>
      <ul class="h2h-list mono">
        {vsAmadeus.map((g) => (
          <li>
            <span class="faint">{longDate(g.date)}</span>
            <span>{g.ourScore}–{g.theirScore}</span>
            <span class="l">sconfitta</span>
          </li>
        ))}
        <li class="win">
          <span class="faint">{longDate(game.date)}</span>
          <span>{game.ourScore}–{game.theirScore}</span>
          <span class="w">vittoria</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section-title">Come è andata, quarto per quarto</h2>

      <div class="quarters">
        {[0, 1, 2, 3].map((i) => {
          const us = q.us[i];
          const them = q.them[i];
          return (
            <div class:list={['qcard', { up: us > them }]}>
              <p class="qcard-n mono">Q{i + 1}</p>
              <p class="qcard-score mono">
                <span class="qs-us">{us}</span>
                <span class="qs-sep">–</span>
                <span class="qs-them">{them}</span>
              </p>
              <p class="qcard-run mono dim">
                {running[i][0]}–{running[i][1]}
              </p>
            </div>
          );
        })}
      </div>

      <p class="section-note dim">
        Tredici a quattro dopo dieci minuti, poi l'Amadeus rientra e all'ultimo
        intervallo il vantaggio è di cinque punti. L'ultimo quarto finisce
        {' '}{q.us[3]}–{q.them[3]}: è il quarto quarto la firma di questa squadra,
        e non solo qui. <a class="link" href="/avanzate/#quarti">I numeri →</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="boxgrid">
        <Referto game={game} />
        <div class="topscorers">
          <h3>I marcatori</h3>
          <ol>
            {topScorers.map((l) => (
              <li>
                <span class="ts-name">{playerName(l.player)}</span>
                <span class="ts-pts mono">{l.points}</span>
                <span
                  class="ts-bar"
                  aria-hidden="true"
                  style={`--w:${(l.points / topScorers[0].points) * 100}%`}
                ></span>
              </li>
            ))}
          </ol>
          <p class="dim topnote">
            Dodici a referto, undici a punti. Nessuno in doppia cifra: la finale
            è stata vinta da tutti insieme, con il massimo di
            {' '}{topScorers[0].points} punti.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="mvp-block">
        <div class="mvp-badge">
          <span class="mvp-num mono">{final.mvp.number}</span>
        </div>
        <div>
          <p class="eyebrow"><span>Miglior giocatore della finale</span></p>
          <h2>{final.mvp.fullName}</h2>
          <p class="dim">
            Sei punti dalla panchina in finale, ma il contributo che si
            ricorda è l'energia portata a partita in corso e le palle rubate
            nei momenti più delicati della gara.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose-block">
      <h2>Curiosità: la maglia numero {sergioNumber}</h2>
      <p>
        Nella tabella qui sopra <strong>{playerName('malavolti-sergio')}</strong>
        {' '}gioca con la maglia numero {sergioNumber}, non la sua: gioca
        abitualmente con la 6. Quel numero è di suo fratello Fabio, playmaker
        come lui, in campo in tutte le otto partite dei playoff, dagli ottavi
        alla bella di semifinale. Alla finale non c'era: aveva già prenotato un
        viaggio in Grecia, convinto che la squadra non sarebbe arrivata così
        lontano. Lo realizzò la notte appena dopo aver vinto gara 2 dei quarti in casa contro il Granarolo. Dopo la vittoria in gara 3 di
        semifinale, non riuscì a trattenere le
        lacrime. A chi gli chiedeva cosa fosse successo disse solo che alla
        finale non ci sarebbe stato. Quel giorno a Loiano, per tenerlo comunque in campo, suo
        fratello Sergio decise di indossare la sua maglia numero 8, rinunciando alla sua numero 6.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section-title">Anche loro venivano da lontano</h2>
      <p class="section-note dim">
        Il cammino del {teamName(opponent)}, l'avversario della finale, fino a
        Loiano.
      </p>
      <ul class="theirrun">
        {theirRun.map((r) => (
          <li>
            <span class="tr-round mono faint">{r.label}</span>
            <span class="tr-opp">{teamName(r.other)}</span>
            <span class="tr-rec mono">{r.wins}–{r.losses}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section gallery-section">
    <div class="wrap">
      <h2 class="section-title">Galleria fotografica</h2>
      <p class="section-note dim">
        Tutto il materiale fotografico sopravvissuto di questa stagione è di
        quel sabato mattina a Loiano.
      </p>
    </div>

    <div class="gallery wrap">
      {gallery.map((p) => (
        <figure>
          <Image
            src={files[p.file]}
            alt={p.alt}
            widths={[640, 1024, 1600]}
            sizes="(max-width: 900px) 100vw, 50vw"
            loading="lazy"
          />
          <figcaption>
            <p>{p.caption}</p>
            <p class="mono faint">{p.credit}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
</Base>

<style>
  /* --- hero -------------------------------------------------------------- */
  .hero {
    position: relative;
    min-height: min(88vh, 780px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
  }
  /* The original is a dark gym interior shot against bright windows, so it
     needs lifting rather than dimming before any overlay goes on top. */
  .hero :global(.hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    filter: saturate(0.75) contrast(1.12) brightness(1.5);
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--ink) 1%, rgba(10, 10, 11, 0.82) 30%, rgba(10, 10, 11, 0.1) 78%),
      linear-gradient(to right, rgba(10, 10, 11, 0.72), rgba(10, 10, 11, 0.05) 62%);
  }
  .hero-body { position: relative; padding-block: 3rem 2.5rem; }
  .hero-body h1 { font-size: var(--step-4); }
  .hero-body .line { display: block; }

  .hero-score {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0.8rem 0 1rem;
    line-height: 1;
  }
  .hero-score .them { font-size: var(--step-4); color: var(--chalk-dim); }
  .hero-score .dash { font-size: var(--step-3); color: var(--chalk-faint); }
  .hero-score .ours {
    font-size: var(--step-5);
    color: var(--giallo);
    font-weight: 700;
  }

  .hero-teams {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    font-size: var(--step--1);
    color: var(--chalk-dim);
    margin: 0;
  }
  .hero-teams span { display: inline-flex; align-items: center; gap: 0.6rem; }
  .hero-teams .us { color: var(--chalk); }

  .hero-credit {
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--chalk-dim);
    margin: 1.8rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid rgba(233, 231, 226, 0.16);
    max-width: 52ch;
  }

  /* --- facts ------------------------------------------------------------- */
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1px;
    background: var(--ink-line-soft);
    border: 1px solid var(--ink-line);
  }
  .facts > div { background: var(--ink-raised); padding: 1rem 1.1rem; }
  .fact-k {
    font-size: 0.58rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--chalk-faint);
    margin-bottom: 0.45rem;
  }
  .fact-v { font-size: var(--step-0); margin: 0; }
  .fact-sub { font-size: 0.65rem; margin: 0.3rem 0 0; }

  .kit {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-right: 0.9rem;
    font-size: var(--step--1);
  }
  .kit::before {
    content: '';
    width: 0.8rem;
    height: 0.8rem;
    border: 1px solid var(--ink-line);
  }
  .kit-us::before { background: var(--giallo); }
  .kit-them::before { background: #111; }

  /* --- prose ------------------------------------------------------------- */
  .prose-block h2 { font-size: var(--step-3); margin-bottom: 1rem; }
  .prose-block p { color: var(--chalk-dim); max-width: 65ch; }

  .h2h-list {
    list-style: none;
    margin: 1.6rem 0 0;
    padding: 0;
    border-top: 1px solid var(--ink-line);
  }
  .h2h-list li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 6rem 7rem;
    gap: 1rem;
    padding: 0.6rem 0.2rem;
    border-bottom: 1px solid var(--ink-line-soft);
    font-size: var(--step--1);
  }
  .h2h-list li.win { background: var(--giallo-wash); box-shadow: inset 3px 0 0 var(--giallo); }
  .h2h-list li > span:nth-child(2) { text-align: right; }

  /* --- quarters ---------------------------------------------------------- */

  .quarters {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--ink-line-soft);
    border: 1px solid var(--ink-line);
    margin-top: 1.4rem;
  }
  .qcard { background: var(--ink-raised); padding: 1.1rem 1rem; }
  .qcard-n {
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    color: var(--chalk-faint);
    margin-bottom: 0.6rem;
  }
  .qcard-score {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    font-size: var(--step-2);
    margin: 0;
  }
  .qs-us { color: var(--chalk); font-weight: 700; }
  .qcard.up .qs-us { color: var(--giallo); }
  .qs-sep { color: var(--chalk-faint); font-size: var(--step-0); }
  .qs-them { color: var(--chalk-dim); font-size: var(--step-1); }
  .qcard-run {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    margin: 0.5rem 0 0;
  }
  .qcard-run::before { content: 'progressivo '; color: var(--chalk-faint); }

  /* --- mvp --------------------------------------------------------------- */
  .mvp-block {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.8rem;
    align-items: start;
    border: 1px solid var(--giallo-deep);
    background: var(--ink-raised);
    padding: clamp(1.2rem, 4vw, 2rem);
  }
  .mvp-badge {
    background: var(--giallo);
    width: clamp(4.5rem, 12vw, 7rem);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }
  .mvp-num {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 7vw, 4.2rem);
    color: var(--ink);
    line-height: 1;
  }
  .mvp-block h2 { font-size: var(--step-3); margin-bottom: 0.8rem; }
  .mvp-block p { font-size: var(--step--1); max-width: 56ch; }
  .mvp-source { font-size: 0.65rem; margin-top: 1rem; }

  /* --- boxscore ---------------------------------------------------------- */
  .boxgrid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }
  .topscorers h3 { font-size: var(--step-1); margin-bottom: 1rem; }
  .topscorers ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.9rem; }
  .topscorers li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem 1rem;
    align-items: baseline;
    padding-bottom: 0.5rem;
    position: relative;
  }
  .ts-name { font-size: var(--step-0); }
  .ts-pts { font-size: var(--step-1); color: var(--giallo); font-weight: 700; }
  .ts-bar {
    grid-column: 1 / -1;
    height: 3px;
    width: var(--w);
    background: var(--giallo-deep);
  }
  .topnote { font-size: var(--step--1); margin-top: 1.4rem; max-width: 40ch; }

  /* --- their run --------------------------------------------------------- */
  .theirrun {
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1px;
    background: var(--ink-line-soft);
    border: 1px solid var(--ink-line);
  }
  .theirrun li {
    background: var(--ink-raised);
    padding: 0.85rem 1rem;
    display: grid;
    gap: 0.25rem;
  }
  .tr-round { font-size: 0.58rem; letter-spacing: 0.16em; text-transform: uppercase; }
  .tr-opp { font-size: var(--step--1); color: var(--chalk-dim); }
  .tr-rec { font-size: var(--step-0); color: var(--chalk); }

  /* --- gallery ----------------------------------------------------------- */
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 30rem), 1fr));
    gap: 1px;
    background: var(--ink-line);
    border-block: 1px solid var(--ink-line);
    margin-top: 1.8rem;
  }
  .gallery figure { margin: 0; background: var(--ink); }
  .gallery :global(img) { width: 100%; height: auto; }
  .gallery figcaption { padding: 0.9rem 1.1rem 1.4rem; }
  .gallery figcaption p { font-size: var(--step--1); margin: 0; }
  .gallery figcaption p + p {
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-top: 0.4rem;
  }

  @media (max-width: 860px) {
    .boxgrid { grid-template-columns: 1fr; }
    .quarters { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mvp-block { grid-template-columns: 1fr; gap: 1.2rem; }
  }
</style>
