---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Referto from '../components/Referto.astro';
import TableSort from '../components/TableSort.astro';
import {
  season, playerName, playerHref, teamName, teamShort, shortDate, num, pct, signed,
  PHASES, scoreLine, scoreSides, playerTotals,
} from '../lib/season.js';

const { playerStats, roster, games, advanced } = season;
const record = advanced.record;
// Season totals count all 23 games; per-game figures divide by the 22 that
// were actually played, since the forfeit was never on the floor.
const onCourt = record.onCourt;

const scorers = playerStats.filter((p) => p.played > 0);

const roleOf = (id) => roster.find((r) => r.id === id)?.role ?? '';

/**
 * The individual table reads two ways at once. One filter picks the arc of the
 * season — the whole thing, the girone alone, the playoff alone: the girone ran
 * from November to April and the playoff through May and June, and they were
 * not the same team, Marconi going from 135 points in fourteen weeks to 147 in
 * nine games. The other picks how a player came into the game, in the quintetto
 * or off the bench, which splits the season down its other axis: 945 of the
 * 1428 points scored on the floor came from the starting five, 483 from the
 * bench, and several men read as two different players either side of it.
 *
 * Every combination recomputes every column rather than hiding rows: a girone
 * average divides by girone games, and a bench average by the games he came on
 * in. `playerTotals` drops anyone the cut leaves with nothing.
 */
const SCOPES = [
  { key: 'all', label: 'Tutte', test: () => true },
  { key: 'girone', label: 'Girone', test: (g) => g.phase === 'girone' },
  { key: 'playoff', label: 'Playoff', test: (g) => g.phase !== 'girone' },
];

/**
 * The second cut. `test` reads a log entry rather than a game, which is what
 * makes the two filters independent — any phase crossed with any of these.
 */
const LINES = [
  { key: 'all', label: 'Tutte', test: null },
  { key: 'quintetto', label: 'Quintetto', test: (l) => l.starter },
  { key: 'panchina', label: 'Panchina', test: (l) => !l.starter },
];

// Every combination, all nine pre-rendered — the filters only say which one
// is on screen.
const panes = SCOPES.flatMap((s) => {
  const base = playerTotals(s.test);
  return LINES.map((ln) => ({
    key: `${s.key}-${ln.key}`,
    scope: s.key,
    line: ln.key,
    data: ln.test ? playerTotals(s.test, ln.test) : base,
  }));
});

// Single-game highs across the season. `starter` comes off the boxscore line
// itself; the share is against what the team scored that night, which is what
// separates a 29 in a 67-point game from a 23 in an 87-point one.
const bestGames = games
  .flatMap((g) =>
    g.boxscore
      .filter((l) => l.played)
      .map((l) => ({ ...l, game: g, sides: scoreSides(g), share: l.points / g.ourScore })),
  )
  .sort((a, b) => b.points - a.points)
  .slice(0, 8);

const phases = ['girone', 'ottavi', 'quarti', 'semifinale', 'finale'];
---

<Base
  title="Statistiche · Caffè Matic – Trottola Sport 2011-2012"
  description="Statistiche individuali, tabellini di tutte le 23 partite e totali di squadra della stagione 2011-2012."
  current="statistiche"
>
  <PageHead
    title="Statistiche"
    facts={[
      `${record.games} partite`,
      `${record.scored} punti fatti`,
      `${record.allowed} subiti`,
      `${scorers.length} marcatori`,
    ]}
  >
    <p>
      Le statistiche di questa stagione sono basate esclusivamente sui referti in nostro possesso.
      Tutto quello che segue è ricostruito da
      lì, sfortunatamente non sono presenti minuti, rimbalzi, assists, palle recuperate stoppate e percentuali di tiro. Ma sono sufficienti per capire
      parecchio. Dei {record.scored} punti di squadra,
      {' '}<strong>{onCourt.scored}</strong> sono stati segnati sul campo: gli
      altri {record.scored - onCourt.scored} sono quelli assegnati per la
      partita vinta a tavolino.
    </p>
  </PageHead>

  <section class="section">
    <div class="wrap">
      <div class="totals">
        <div>
          <p class="t-k mono">Bilancio</p>
          <p class="t-v">{record.wins}<span class="t-sep">–</span>{record.losses}</p>
          <p class="t-sub mono dim">
            su {record.games} partite, una delle quali vinta a tavolino
          </p>
        </div>
        <div>
          <p class="t-k mono">Punti a partita</p>
          <p class="t-v">{num(onCourt.avgFor, 1)}</p>
          <p class="t-sub mono dim">
            contro {num(onCourt.avgAgainst, 1)} subiti, sulle {onCourt.games} giocate sul campo
          </p>
        </div>
        <div>
          <p class="t-k mono">Scarto medio</p>
          <p class="t-v">+{num(onCourt.avgMargin, 1)}</p>
          <p class="t-sub mono dim">
            +{onCourt.diff} sul campo, +{record.diff} con il 30–0 a tavolino
          </p>
        </div>
        <div>
          <p class="t-k mono">Striscia</p>
          <p class="t-v">{record.bestWinStreak}</p>
          <p class="t-sub mono dim">vittorie di fila, da gennaio ad aprile</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="section-title">Stagione individuale</h2>
        <p class="section-note">
          <strong>Presenze</strong> è quante volte un giocatore è andato a
          referto, <strong>Entrato</strong> quante volte è effettivamente
          entrato: la differenza sono le <span class="mono giallo">NE</span>.{' '}
          Ordinata per punti: <strong>clicca un'intestazione</strong> per
          cambiare criterio,{' '}
          <strong>clicca un nome</strong> per la stagione completa di quel
          giocatore.
        </p>
      </div>

      {/* The controls ship hidden and the script below reveals them, so a page
          whose JavaScript never arrives keeps the whole-season table it has
          always had instead of six buttons that do nothing. The two rows are
          labelled because "Tutte" is in both of them, and unlabelled they
          would read as one confused set. */}
      <div class="filters" hidden>
        <div class="filter-row">
          <span class="filter-k mono">Fase</span>
          <div class="scopes" data-filter="scope" role="group" aria-label="Filtra per fase">
            {SCOPES.map((s, i) => (
              <button type="button" data-value={s.key} aria-pressed={i === 0}>
                {s.label}
              </button>
            ))}
          </div>
        </div>
        <div class="filter-row">
          <span class="filter-k mono">In campo</span>
          <div
            class="scopes"
            data-filter="line"
            role="group"
            aria-label="Filtra per quintetto o panchina"
          >
            {LINES.map((ln, i) => (
              <button type="button" data-value={ln.key} aria-pressed={i === 0}>
                {ln.label}
              </button>
            ))}
          </div>
        </div>
      </div>

      {panes.map((pane) => (
        <div
          class="scope-pane"
          data-scope={pane.scope}
          data-line={pane.line}
          hidden={pane.key !== 'all-all'}
        >
          <div class="table-scroll">
            <table class="individuale" data-sortable data-stack data-dense>
              <thead>
                <tr>
                  <th scope="col" class="num rank">#</th>
                  <th scope="col" class="name" data-sort="text">Giocatore</th>
                  <th scope="col" data-sort="text">Ruolo</th>
                  <th scope="col" class="num" data-sort="num" aria-sort="descending">Punti</th>
                  <th scope="col" class="num" data-sort="num">Media</th>
                  {pane.line === 'all' ? (
                    <Fragment>
                      <th scope="col" class="num" data-sort="num">Presenze</th>
                      <th scope="col" class="num entrato" data-sort="num">Entrato</th>
                      <th scope="col" class="num" data-sort="num">Quintetto</th>
                    </Fragment>
                  ) : (
                    /* Dressed, entered and started are the same number once the
                       cut is made, so the three columns say one thing. */
                    <th scope="col" class="num" data-sort="num">Partite</th>
                  )}
                  <th scope="col" class="num" data-sort="num">High</th>
                  <th scope="col" class="num" data-sort="num">10+</th>
                  <th scope="col" class="num" data-sort="num">Quota</th>
                </tr>
              </thead>
              <tbody>
                {pane.data.rows.map((p, i) => (
                  <tr>
                    <td class="num rank faint" data-head><span data-rank>{i + 1}</span></td>
                    <td class="name" data-head>
                      <a class="p-link" href={playerHref(p.player)}>{playerName(p.player)}</a>
                    </td>
                    <td data-label="Ruolo"><span class="role mono">{roleOf(p.player)}</span></td>
                    <td class="num pts" data-v={p.points} data-head>
                      <span class="pts-v">{p.points}</span>
                      <span class="pts-track" aria-hidden="true">
                        <span class="pts-bar" style={`--w:${(p.points / pane.data.topScorer) * 100}%`}></span>
                      </span>
                    </td>
                    {/* A player who dressed and never entered has no average,
                        no high and no share — only a denominator of zero. The
                        dash says so, and −1 sorts it below a genuine nought.
                        Under a lineup filter he is not a row at all. */}
                    <td class="num" data-v={p.average ?? -1} data-label="Media">
                      {p.average === null ? '—' : num(p.average, 1)}
                    </td>
                    {pane.line === 'all' ? (
                      <Fragment>
                        <td class="num dim" data-label="Presenze">{p.games}</td>
                        <td class="num entrato" data-v={p.played} data-label="Entrato">
                          {p.played}
                          {p.games > p.played && (
                            <span class="ne mono">{p.games - p.played} NE</span>
                          )}
                        </td>
                        <td class="num" data-label="Quintetto">{p.starts}</td>
                      </Fragment>
                    ) : (
                      <td class="num" data-label="Partite">{p.played}</td>
                    )}
                    <td class="num" data-v={p.high ?? -1} data-label="High">
                      {p.high === null ? '—' : p.high}
                    </td>
                    <td class="num" data-label="10+">{p.doubleFigures}</td>
                    <td class="num dim" data-v={p.share === null ? -1 : p.points} data-label="Quota">
                      {p.share === null ? '—' : pct(p.share, 1)}
                    </td>
                  </tr>
                ))}
              </tbody>
              <tfoot>
                <tr>
                  <td></td>
                  <td data-head>Squadra</td>
                  <td></td>
                  {/* What that group scored, which on the unfiltered panes is
                      simply what the team scored. */}
                  <td class="num strong" data-head>{pane.data.linePoints}</td>
                  <td class="num" data-label="Media">{num(pane.data.avgLine, 1)}</td>
                  <td class="num" colspan={pane.line === 'all' ? 6 : 4}></td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section-title">Le migliori partite</h2>
      <p class="section-note dim">
        Le otto serate migliori: chi partiva in quintetto e chi è entrato dalla
        panchina, com'è finita la partita e la quota dei punti di squadra
        segnata quella sera. Il nostro punteggio è quello in evidenza.
      </p>
      <ol class="bests">
        {bestGames.map((b) => (
          <li>
            <span class="b-pts mono">{b.points}</span>
            <span class="b-who">
              <a class="b-name p-link" href={playerHref(b.player)}>{playerName(b.player)}</a>
              <span class:list={['b-role', 'mono', b.starter ? 'start' : 'bench']}>
                {b.starter ? 'quintetto' : 'panchina'}
              </span>
            </span>
            <span class="b-ctx mono dim">
              {teamShort(b.game.opponent)} · {PHASES[b.game.phase]}
            </span>
            {/* Home team first, so ours is not always the number on the left —
                which is exactly why it is the one that carries the colour. */}
            <span class:list={['b-res', 'mono', b.game.won ? 'won' : 'lost']}>
              <span class={b.sides.oursFirst ? 'ours' : 'theirs'}>{b.sides.first}</span>
              <span class="sep">–</span>
              <span class={b.sides.oursFirst ? 'theirs' : 'ours'}>{b.sides.second}</span>
              <span class:list={['b-margin', b.game.won ? 'w' : 'l']}>
                {signed(b.game.margin, 0)}
              </span>
            </span>
            <span class="b-quota mono dim">{pct(b.share, 0)}</span>
            <a class="b-link mono" href={`#g${b.game.seq}`}>tabellino</a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="tabellini">
    <div class="wrap">
      <h2 class="section-title">Tutti i tabellini</h2>
      <p class="section-note dim">
        Ventitré partite, ventidue giocate sul campo: il quintetto è
        segnato con la <span class="mono giallo">X</span>, chi non è entrato
        con{' '}<span class="mono giallo">NE</span>.
      </p>

      {phases.map((phase) => {
        const list = games.filter((g) => g.phase === phase);
        return (
          <div class="phase-block">
            <h3 class="phase-title">
              {PHASES[phase]}
              <span class="phase-count mono dim">
                {list.length} {list.length === 1 ? 'partita' : 'partite'}
              </span>
            </h3>
            <div class="referti">
              {list.map((g) => (
                <details class="rf" id={`g${g.seq}`}>
                  <summary>
                    <span class="rf-seq mono">{String(g.seq).padStart(2, '0')}</span>
                    <span class="rf-label">
                      {teamName(g.opponent)}
                      <span class="rf-meta mono dim">
                        {shortDate(g.date)} · {g.neutral
                          ? 'campo neutro'
                          : g.ourSide === 'home' ? 'in casa' : 'in trasferta'}
                      </span>
                    </span>
                    <span class:list={['rf-score', 'mono', g.won ? 'won' : 'lost']}>
                      {scoreLine(g)}
                    </span>
                    <span class="rf-chevron" aria-hidden="true">›</span>
                  </summary>
                  <Referto game={g} bare />
                </details>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <TableSort />
</Base>

<script>
  /* All nine views of the individual table are in the page; the two filters
     only say which one is on screen. They are independent, so the state is a
     pair and a pane shows when both halves match it. Without this script the
     controls stay hidden and the whole-season pane is the page, exactly as
     before. */
  const filters = document.querySelector('.filters');
  const groups = [...document.querySelectorAll('.scopes[data-filter]')];
  const panes = [...document.querySelectorAll('.scope-pane')];

  if (filters && groups.length && panes.length) {
    filters.hidden = false;

    const state = {};
    for (const group of groups) {
      const on = group.querySelector('button[aria-pressed="true"]');
      state[group.dataset.filter] = on instanceof HTMLElement ? on.dataset.value : '';
    }

    const show = () => {
      for (const pane of panes) {
        pane.hidden =
          pane.dataset.scope !== state.scope || pane.dataset.line !== state.line;
      }

      /* Base.astro sizes the "scorri in orizzontale" hints on load and on
         resize. A pane that was hidden measured nothing, so the one just
         revealed would never get its hint: ask for a fresh pass. */
      dispatchEvent(new Event('resize'));
    };

    for (const group of groups) {
      group.addEventListener('click', (e) => {
        const el = e.target instanceof Element ? e.target : null;
        const button = el?.closest('button[data-value]');
        if (!(button instanceof HTMLButtonElement)) return;

        for (const b of group.querySelectorAll('button[data-value]')) {
          b.setAttribute('aria-pressed', String(b === button));
        }
        state[group.dataset.filter] = button.dataset.value;
        show();
      });
    }
  }

  /* A "tabellino" link points at a fold that ships closed, so the jump alone
     would land on the summary with the sheet still shut. Opening it and marking
     it keeps the anchor honest; with no JavaScript the link still scrolls to
     the right game and the reader opens it themselves. */
  let marked = null;

  const clear = () => {
    marked?.classList.remove('hit');
    marked = null;
  };

  const openTarget = () => {
    clear();
    if (!location.hash) return;
    const el = document.querySelector(location.hash);
    if (!(el instanceof HTMLDetailsElement)) return;
    el.open = true;
    el.classList.add('hit');
    marked = el;
  };

  openTarget();
  addEventListener('hashchange', openTarget);

  /* The mark only has a job until the reader has found the sheet, so the next
     thing they do takes it off — collapsing it, opening another, following a
     link. The jump links themselves are the exception: clicking the same
     "tabellino" twice fires no hashchange, and clearing here would leave
     nothing lit. */
  addEventListener('click', (e) => {
    if (!marked) return;
    const el = e.target instanceof Element ? e.target : null;
    if (el?.closest('a[href^="#g"]')) return;
    clear();
  });
  addEventListener('keydown', clear);
</script>

<style>

  .totals {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1px;
    background: var(--ink-line-soft);
    border: 1px solid var(--ink-line);
  }
  .totals > div { background: var(--ink-raised); padding: 1.2rem 1.1rem; }
  .t-k {
    font-size: 0.58rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--chalk-faint);
    margin-bottom: 0.5rem;
  }
  .t-v {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1;
    color: var(--giallo);
    margin: 0;
  }
  .t-sep { color: var(--chalk-faint); margin: 0 0.1em; }
  .t-sub { font-size: 0.63rem; letter-spacing: 0.06em; margin: 0.55rem 0 0; }

  td.strong { color: var(--chalk); font-weight: 700; }

  /* --- the two filters ------------------------------------------------------ */

  .filters {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 1.2rem 0 0;
  }
  /* Stated rather than left to the user agent: the `display` above is a
     declaration on the element itself and beats the UA's [hidden] rule, so
     without this both rows would show on a page with no JavaScript. */
  .filters[hidden] { display: none; }

  /* The label wraps above its buttons rather than pushing them, so at 320px
     the row gets taller instead of the page getting wider. */
  .filter-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.7rem;
    max-width: 100%;
  }
  /* The width is the longer of the two labels, so the two button rows start at
     the same x instead of stepping. When the row wraps the label takes its own
     line and the reservation costs nothing. */
  .filter-k {
    font-size: 0.58rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--chalk-faint);
    min-width: 4.25rem;
  }

  /* One hairline-joined row, the same frame the totals strip above is built
     from. It wraps rather than widening the page — nothing here may put the
     body into a sideways scroll. */
  .scopes {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    width: max-content;
    max-width: 100%;
    background: var(--ink-line-soft);
    border: 1px solid var(--ink-line);
  }
  .scopes button {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--chalk-dim);
    background: var(--ink-raised);
    border: 0;
    padding: 0.6rem 1rem;
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .scopes button:hover { color: var(--giallo); }
  .scopes button[aria-pressed='true'] {
    color: var(--giallo);
    background: var(--giallo-wash);
    box-shadow: inset 0 -2px 0 var(--giallo);
  }

  /* A standalone control, so it takes the whole tap target. */
  @media (max-width: 799px), (hover: none) {
    .scopes button { min-height: var(--tap); padding-inline: 0.9rem; }
  }

  /* Stated rather than left to the user agent: below 800px global.css makes
     `table[data-stack]` a block, which would beat the UA's [hidden] rule and
     put all nine tables on screen at once. The attribute is on the pane for
     the same reason, never on the table. */
  .scope-pane[hidden] { display: none; }
  .scope-pane { margin-top: 1.2rem; }

  /* --- individual season -------------------------------------------------- */
  .individuale td { padding-block: 0.6rem; }
  .individuale th.rank, .individuale td.rank { width: 3rem; }
  .individuale td.name { color: var(--chalk); }

  /* Card mode sets its own spacing on the row; per-cell padding would stack
     eleven times down one card. This has to sit after the 3rem rank column,
     which is no more specific and would otherwise win on source order. */
  @media (max-width: 799px) {
    .individuale td { padding-block: 0; }
    /* Wide enough for two digits, so the names still line up under each
       other; the desktop column would leave a hole beside a single one. */
    .individuale td.rank { width: 1.5rem; }
    /* The one word among ten figures. Faint is the labels' colour, so at that
       weight the role read as a second label rather than as its value. */
    .individuale .role { color: var(--chalk-dim); letter-spacing: 0.04em; }
  }

  .role {
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--chalk-faint);
  }

  /* Points carry a bar drawn against the season's top scorer: the column is
     the one place where the shape of the scoring is visible at a glance. */
  .pts-v { font-family: var(--font-mono); color: var(--chalk); font-weight: 700; }
  .pts-track {
    display: block;
    width: 3.5rem;
    height: 2px;
    margin: 0.35rem 0 0 auto;
    background: var(--ink-line);
  }
  .pts-bar { display: block; height: 100%; width: var(--w); background: var(--giallo-deep); }
  tbody tr:hover .pts-bar { background: var(--giallo); }

  /* The games a player dressed for but never entered, named on the row that
     would otherwise only say he was there. Inline, so the rows that carry one
     keep the same height as the rows that don't. */
  .ne {
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    color: var(--giallo-deep);
    margin-left: 0.45rem;
  }

  /* The column is right-aligned, so a badge printed after the figure pushes
     that figure left — and only on the rows that carry one, which sets the
     whole column zigzagging. The cell reserves a gutter for the badge to the
     right of the figures instead, and the badge cancels its own width with an
     equal negative margin, the idiom the tap targets already use: it takes no
     room on the line, so every figure keeps the column's right edge and every
     badge starts at the same x. The header reserves the same gutter, which
     leaves its label over the figures rather than over the badges. */
  @media (min-width: 800px) {
    .individuale .entrato { --ne-gutter: 2.5rem; }
    .individuale th.entrato,
    .individuale td.entrato { padding-right: calc(0.7rem + var(--ne-gutter)); }
    .individuale td.entrato .ne {
      display: inline-block;
      width: var(--ne-gutter);
      margin: 0 calc(var(--ne-gutter) * -1) 0 0;
      padding-left: 0.45rem;
      text-align: left;
    }
  }

  /* Below the width where eleven columns fit, the name stays put while the
     numbers scroll under it — a row is unreadable without knowing whose. The
