---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Referto from '../components/Referto.astro';
import TableSort from '../components/TableSort.astro';
import { season, playerName, playerHref, num, PHASES, scoreLine } from '../lib/season.js';

const { playerStats, roster, games, advanced } = season;
const record = advanced.record;
// Season totals count all 23 games; per-game figures divide by the 22 that
// were actually played, since the forfeit was never on the floor.
const onCourt = record.onCourt;

const scorers = playerStats.filter((p) => p.played > 0);
// Quota is a share of the points the players actually scored, so it divides by
// the boxscore total. The 30 awarded for the forfeit belong to no one.
const totalPoints = onCourt.scored;

const roleOf = (id) => roster.find((r) => r.id === id)?.role ?? '';

// Every scoring line is drawn against the season's top scorer, so the column
// reads as a hierarchy at a glance and not as nineteen loose numbers.
const topScorer = Math.max(...playerStats.map((p) => p.points));

// Single-game highs across the season.
const bestGames = games
  .flatMap((g) =>
    g.boxscore
      .filter((l) => l.played)
      .map((l) => ({ ...l, game: g })),
  )
  .sort((a, b) => b.points - a.points)
  .slice(0, 8);

const phases = ['girone', 'ottavi', 'quarti', 'semifinale', 'finale'];
---

<Base
  title="Statistiche · Caffè Matic – Trottola Sport 2011-2012"
  description="Statistiche individuali, tabellini di tutte le 23 partite e totali di squadra della stagione 2011-2012."
  current="statistiche"
>
  <PageHead
    title="Statistiche"
    facts={[
      `${record.games} partite`,
      `${record.scored} punti fatti`,
      `${record.allowed} subiti`,
      `${scorers.length} marcatori`,
    ]}
  >
    <p>
      Le statistiche di questa stagione sono basate esclusivamente sui referti in nostro possesso.
      Tutto quello che segue è ricostruito da
      lì, sfortunatamente non sono presenti minuti, rimbalzi, assists, palle recuperate stoppate e percentuali di tiro. Ma sono sufficienti per capire
      parecchio. Dei {record.scored} punti di squadra,
      {' '}<strong>{onCourt.scored}</strong> sono stati segnati sul campo: gli
      altri {record.scored - onCourt.scored} sono quelli assegnati per la
      partita vinta a tavolino, e non appartengono a nessuno.
    </p>
  </PageHead>

  <section class="section">
    <div class="wrap">
      <div class="totals">
        <div>
          <p class="t-k mono">Bilancio</p>
          <p class="t-v">{record.wins}<span class="t-sep">–</span>{record.losses}</p>
          <p class="t-sub mono dim">
            su {record.games} partite, una delle quali vinta a tavolino
          </p>
        </div>
        <div>
          <p class="t-k mono">Punti a partita</p>
          <p class="t-v">{num(onCourt.avgFor, 1)}</p>
          <p class="t-sub mono dim">
            contro {num(onCourt.avgAgainst, 1)} subiti, sulle {onCourt.games} giocate sul campo
          </p>
        </div>
        <div>
          <p class="t-k mono">Scarto medio</p>
          <p class="t-v">+{num(onCourt.avgMargin, 1)}</p>
          <p class="t-sub mono dim">
            +{onCourt.diff} sul campo, +{record.diff} con il 30–0 a tavolino
          </p>
        </div>
        <div>
          <p class="t-k mono">Striscia</p>
          <p class="t-v">{record.bestWinStreak}</p>
          <p class="t-sub mono dim">vittorie di fila, da gennaio ad aprile</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="section-title">Stagione individuale</h2>
        <p class="section-note">
          <strong>Presenze</strong> è quante volte un giocatore è andato a
          referto, <strong>Entrato</strong> quante volte è effettivamente
          entrato: la differenza sono le <span class="mono giallo">NE</span>.{' '}
          <strong>Quota</strong> è la percentuale dei punti di squadra.
          Ordinata per punti: <strong>clicca un'intestazione</strong> per
          cambiare criterio, <strong>clicca un nome</strong> per la stagione
          completa di quel giocatore.
        </p>
      </div>

      <div class="table-scroll">
        <table class="individuale" data-sortable data-stack data-dense>
          <thead>
            <tr>
              <th scope="col" class="num rank">#</th>
              <th scope="col" class="name" data-sort="text">Giocatore</th>
              <th scope="col" data-sort="text">Ruolo</th>
              <th scope="col" class="num" data-sort="num" aria-sort="descending">Punti</th>
              <th scope="col" class="num" data-sort="num">Media</th>
              <th scope="col" class="num" data-sort="num">Presenze</th>
              <th scope="col" class="num" data-sort="num">Entrato</th>
              <th scope="col" class="num" data-sort="num">Quintetto</th>
              <th scope="col" class="num" data-sort="num">High</th>
              <th scope="col" class="num" data-sort="num">10+</th>
              <th scope="col" class="num" data-sort="num">Quota</th>
            </tr>
          </thead>
          <tbody>
            {playerStats.map((p, i) => (
              <tr>
                <td class="num rank faint" data-head><span data-rank>{i + 1}</span></td>
                <td class="name" data-head>
                  <a class="p-link" href={playerHref(p.player)}>{playerName(p.player)}</a>
                </td>
                <td data-label="Ruolo"><span class="role mono">{roleOf(p.player)}</span></td>
                <td class="num pts" data-v={p.points} data-head>
                  <span class="pts-v">{p.points}</span>
                  <span class="pts-track" aria-hidden="true">
                    <span class="pts-bar" style={`--w:${(p.points / topScorer) * 100}%`}></span>
                  </span>
                </td>
                <td class="num" data-label="Media">{num(p.average, 1)}</td>
                <td class="num dim" data-label="Presenze">{p.games}</td>
                <td class="num" data-v={p.played} data-label="Entrato">
                  {p.played}
                  {p.games > p.played && (
                    <span class="ne mono">{p.games - p.played} NE</span>
                  )}
                </td>
                <td class="num" data-label="Quintetto">{p.starts}</td>
                <td class="num" data-label="High">{p.high}</td>
                <td class="num" data-label="10+">{p.doubleFigures}</td>
                <td class="num dim" data-v={p.points} data-label="Quota">
                  {num((p.points / totalPoints) * 100, 1)}%
                </td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr>
              <td></td>
              <td data-head>Squadra</td>
              <td></td>
              <td class="num strong" data-head>{totalPoints}</td>
              <td class="num" data-label="Media">{num(onCourt.avgFor, 1)}</td>
              <td class="num" colspan="6"></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section-title">Le migliori partite</h2>
      <ol class="bests">
        {bestGames.map((b) => (
          <li>
            <span class="b-pts mono">{b.points}</span>
            <span class="b-name">{playerName(b.player)}</span>
            <span class="b-ctx mono dim">
              {PHASES[b.game.phase]} · {scoreLine(b.game)}
            </span>
            <a class="b-link mono" href={`#g${b.game.seq}`}>tabellino</a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="tabellini">
    <div class="wrap">
      <h2 class="section-title">Tutti i tabellini</h2>
      <p class="section-note dim">
        Ventitré partite in ordine di data, come sul referto: il quintetto
        segnato con la <span class="mono giallo">X</span>, chi non è entrato
        con{' '}<span class="mono giallo">NE</span>. Dove esistono, i parziali
        per quarto vengono dal database.
      </p>

      {phases.map((phase) => {
        const list = games.filter((g) => g.phase === phase);
        return (
          <div class="phase-block">
            <h3 class="phase-title">
              {PHASES[phase]}
              <span class="phase-count mono dim">
                {list.length} {list.length === 1 ? 'partita' : 'partite'}
              </span>
            </h3>
            <div class="referti">
              {list.map((g) => <Referto game={g} />)}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <TableSort />
</Base>

<style>

  .totals {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1px;
    background: var(--ink-line-soft);
    border: 1px solid var(--ink-line);
  }
  .totals > div { background: var(--ink-raised); padding: 1.2rem 1.1rem; }
  .t-k {
    font-size: 0.58rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--chalk-faint);
    margin-bottom: 0.5rem;
  }
  .t-v {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1;
    color: var(--giallo);
    margin: 0;
  }
  .t-sep { color: var(--chalk-faint); margin: 0 0.1em; }
  .t-sub { font-size: 0.63rem; letter-spacing: 0.06em; margin: 0.55rem 0 0; }

  td.strong { color: var(--chalk); font-weight: 700; }

  /* --- individual season -------------------------------------------------- */
  .individuale td { padding-block: 0.6rem; }
  .individuale th.rank, .individuale td.rank { width: 3rem; }
  .individuale td.name { color: var(--chalk); }

  /* Card mode sets its own spacing on the row; per-cell padding would stack
     eleven times down one card. This has to sit after the 3rem rank column,
     which is no more specific and would otherwise win on source order. */
  @media (max-width: 799px) {
    .individuale td { padding-block: 0; }
    /* Wide enough for two digits, so the names still line up under each
       other; the desktop column would leave a hole beside a single one. */
    .individuale td.rank { width: 1.5rem; }
    /* The one word among ten figures. Faint is the labels' colour, so at that
       weight the role read as a second label rather than as its value. */
    .individuale .role { color: var(--chalk-dim); letter-spacing: 0.04em; }
  }

  .role {
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--chalk-faint);
  }

  /* Points carry a bar drawn against the season's top scorer: the column is
     the one place where the shape of the scoring is visible at a glance. */
  .pts-v { font-family: var(--font-mono); color: var(--chalk); font-weight: 700; }
  .pts-track {
    display: block;
    width: 3.5rem;
    height: 2px;
    margin: 0.35rem 0 0 auto;
    background: var(--ink-line);
  }
  .pts-bar { display: block; height: 100%; width: var(--w); background: var(--giallo-deep); }
  tbody tr:hover .pts-bar { background: var(--giallo); }

  /* The games a player dressed for but never entered, named on the row that
     would otherwise only say he was there. Inline, so the rows that carry one
     keep the same height as the rows that don't. */
  .ne {
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    color: var(--giallo-deep);
    margin-left: 0.45rem;
  }

  /* Below the width where eleven columns fit, the name stays put while the
     numbers scroll under it — a row is unreadable without knowing whose. The
     floor is the card breakpoint: below it the table does not scroll at all,
     and the rank belongs in the headline rather than hidden. */
  @media (min-width: 800px) and (max-width: 980px) {
    .individuale th.rank, .individuale td.rank { display: none; }
    .individuale th.name, .individuale td.name {
      position: sticky;
      left: 0;
      z-index: 1;
      background: var(--ink);
      box-shadow: 1px 0 0 var(--ink-line);
    }
    .individuale thead th.name { z-index: 3; }
    .individuale tbody tr:hover td.name { background: var(--ink-raised); }
  }

  tfoot td {
    border-bottom: 0;
    border-top: 1px solid var(--ink-line);
    color: var(--chalk-dim);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .bests {
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--ink-line-soft);
    border: 1px solid var(--ink-line);
  }
  .bests li {
    background: var(--ink-raised);
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 1.1fr) auto;
    gap: 1rem;
    align-items: baseline;
    padding: 0.7rem 1rem;
  }
  .b-pts { font-size: var(--step-2); color: var(--giallo); font-weight: 700; }
  .b-name { font-size: var(--step-0); }
  .b-ctx { font-size: 0.68rem; }
  .b-link {
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--chalk-dim);
    text-decoration: none;
    border-bottom: 1px solid var(--ink-line);
  }
  .b-link:hover { color: var(--giallo); border-bottom-color: var(--giallo-deep); }

  .phase-block + .phase-block { margin-top: 3rem; }
  .phase-title {
    font-size: var(--step-1);
    display: flex;
    align-items: baseline;
    gap: 1rem;
    border-bottom: 1px solid var(--ink-line);
    padding-bottom: 0.5rem;
    margin-bottom: 1.2rem;
  }
  .phase-count {
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .referti {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    gap: 1rem;
  }

  @media (max-width: 700px) {
    .bests li {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      row-gap: 0.2rem;
    }
    .b-ctx, .b-link { grid-column: 2; }
  }
</style>
