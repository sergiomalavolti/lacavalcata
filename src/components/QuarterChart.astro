---
import { season, num } from '../lib/season.js';

/**
 * Points per quarter, ours against theirs.
 *
 * Two series with identity, so both are coloured, both are in the legend and
 * every bar is directly labelled — no tooltip needed on eight labelled marks.
 */
const rows = season.advanced.quarters.rows;
const sample = season.advanced.quarters.sample;

const W = 880;
const H = 300;
const PAD = { top: 34, right: 20, bottom: 46, left: 42 };
const max = 20;

const plotH = H - PAD.top - PAD.bottom;
const groupW = (W - PAD.left - PAD.right) / 4;
const barW = Math.min(52, groupW / 2 - 8);
const GAP = 2; // surface gap between the paired bars

const yOf = (v) => PAD.top + plotH - (v / max) * plotH;
const hOf = (v) => (v / max) * plotH;
const groupX = (i) => PAD.left + i * groupW;
---

<figure class="chart">
  <figcaption>
    <h3>Punti per quarto</h3>
    <p class="dim">
      Media punti per quarto su {sample} partite con parziali disponibili. Il
      quarto periodo è quello in cui la squadra segnava di più e concedeva il
      secondo margine più ampio della partita.
    </p>
  </figcaption>

  <ul class="legend">
    <li><span class="sw sw-us"></span>Caffè Matic</li>
    <li><span class="sw sw-them"></span>Avversari</li>
  </ul>

  <div class="chart-plot">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="q-desc">
      <desc id="q-desc">
        Media per quarto: {rows.map((r) => `Q${r.quarter} ${num(r.usAvg, 1)} contro ${num(r.themAvg, 1)}`).join('; ')}.
      </desc>

      {[0, 5, 10, 15, 20].map((v) => (
        <>
          <line x1={PAD.left} x2={W - PAD.right} y1={yOf(v)} y2={yOf(v)} class="grid" />
          <text x={PAD.left - 10} y={yOf(v)} class="axis-y">{v}</text>
        </>
      ))}

      {rows.map((r, i) => {
        const cx = groupX(i) + groupW / 2;
        return (
          <>
            <rect
              x={cx - barW - GAP / 2} y={yOf(r.usAvg)}
              width={barW} height={hOf(r.usAvg)}
              rx="4" class="bar-us"
            />
            <rect
              x={cx + GAP / 2} y={yOf(r.themAvg)}
              width={barW} height={hOf(r.themAvg)}
              rx="4" class="bar-them"
            />
            <text x={cx - barW / 2 - GAP / 2} y={yOf(r.usAvg) - 9} class="val val-us">
              {num(r.usAvg, 1)}
            </text>
            <text x={cx + barW / 2 + GAP / 2} y={yOf(r.themAvg) - 9} class="val val-them">
              {num(r.themAvg, 1)}
            </text>
            <text x={cx} y={H - PAD.bottom + 22} class="axis-x">Q{r.quarter}</text>
            <text x={cx} y={H - PAD.bottom + 38} class="axis-sub">
              {r.won} quarti vinti su {sample}
            </text>
          </>
        );
      })}

      <line x1={PAD.left} x2={W - PAD.right} y1={yOf(0)} y2={yOf(0)} class="baseline" />
    </svg>
  </div>
</figure>

<style>

  .legend {
    list-style: none;
    display: flex;
    gap: 1.4rem;
    margin: 0 0 0.9rem;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--chalk-dim);
  }
  .legend li { display: flex; align-items: center; gap: 0.5rem; }
  .sw { width: 0.85rem; height: 0.85rem; border-radius: 2px; }
  .sw-us { background: var(--c-us); }
  .sw-them { background: var(--c-them); }

  .chart-plot {
    background: var(--ink-raised);
    border: 1px solid var(--ink-line);
    padding: 0.8rem 0.6rem 0.4rem;
  }
  svg { width: 100%; height: auto; display: block; }

  .grid { stroke: var(--c-grid); stroke-width: 1; }
  .baseline { stroke: var(--ink-line); stroke-width: 1.5; }

  .bar-us { fill: var(--c-us); }
  .bar-them { fill: var(--c-them); }

  .axis-y {
    fill: var(--chalk-faint);
    font-family: var(--font-mono);
    font-size: 11px;
    text-anchor: end;
    dominant-baseline: middle;
  }
  .axis-x {
    fill: var(--chalk-dim);
    font-family: var(--font-mono);
    font-size: 13px;
    text-anchor: middle;
  }
  .axis-sub {
    fill: var(--chalk-faint);
    font-family: var(--font-mono);
    font-size: 9.5px;
    text-anchor: middle;
    letter-spacing: 0.08em;
  }

  /* Values wear text tokens, not the series colour. */
  .val {
    font-family: var(--font-mono);
    font-size: 12px;
    text-anchor: middle;
    fill: var(--chalk);
  }
  .val-them { fill: var(--chalk-dim); }
</style>
