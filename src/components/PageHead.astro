---
/** Page opening. The eyebrow items are always facts from the dataset. */
const { title, facts = [] } = Astro.props;
---

<header class="pagehead">
  <div class="wrap">
    <p class="eyebrow">
      {facts.map((f) => <span>{f}</span>)}
    </p>
    <h1>{title}</h1>
    <div class="pagehead-lead"><slot /></div>
  </div>
</header>

<style>
  .pagehead {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--ink-line);
  }
  .pagehead h1 { max-width: 18ch; }
  .pagehead-lead {
    margin-top: 1.4rem;
    max-width: 60ch;
    color: var(--chalk-dim);
    font-size: var(--step-0);
  }
  .pagehead-lead :global(strong) { color: var(--chalk); font-weight: 600; }
</style>
